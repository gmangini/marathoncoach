# Secret names only, never values. Copy to .env (git-ignored) and fill in.

# Discord (https://discord.com/developers/applications -> your app -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=
# Your own Discord user ID (Settings -> Advanced -> Developer Mode, then right-click your name -> Copy User ID)
DISCORD_OWNER_ID=
# Optional: your private server's ID, so /commands show up instantly
DISCORD_GUILD_ID=

# Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Garmin Connect (slice 2)
GARMIN_LOGIN=
GARMIN_PASSWORD=

# Coaching (RACE_DATE as yyyy-MM-dd; GOAL_TIME default 3:30:00 sets the pace zones)
RACE_DATE=
RACE_NAME=
GOAL_TIME=3:30:00
COACH_GOAL=
RUN_NOTES=

# Optional: where the chat history is saved (default data/chat-history.json, git-ignored)
CHAT_HISTORY_PATH=

# Optional: daily DM with the day's workout at this local time (24 h), e.g. 06:30
MORNING_TIME=

# Server only: time zone for "today" and MORNING_TIME (a server clock is UTC otherwise)
TZ=America/Denver
