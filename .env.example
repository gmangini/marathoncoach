# Secret names only, never values. Copy to .env (git-ignored) and fill in.

# Discord (https://discord.com/developers/applications -> your app -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=
# Your own Discord user ID (Settings -> Advanced -> Developer Mode, then right-click your name -> Copy User ID)
DISCORD_OWNER_ID=
# Optional: your private server's ID, so /commands show up instantly
DISCORD_GUILD_ID=

# Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Garmin Connect (slice 2)
GARMIN_LOGIN=
GARMIN_PASSWORD=

# Coaching
RACE_DATE=
COACH_GOAL=
RUN_NOTES=
